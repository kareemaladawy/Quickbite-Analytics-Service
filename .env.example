PORT=4100
NODE_ENV=development

# Must match core-service / order-service's ACCESS_SECRET exactly.
ACCESS_SECRET=dev-access-secret-change-me

MONGO_URI=mongodb://localhost:27017
MONGO_DB=quickbite_analytics

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_ORDER_EVENTS_EXCHANGE=order.events
RABBITMQ_QUEUE=analytics-service.order-events
RABBITMQ_BINDINGS=order.#,payment.#
RABBITMQ_DLX=order.events.dlx
RABBITMQ_DLQ=analytics-service.order-events.dlq
RABBITMQ_PREFETCH=32

# Second consumer — core-service's own outbound exchange, carries
# rbac.permissions_changed (see docs/implementation-plan.md Phase 10).
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events
RABBITMQ_CORE_EVENTS_QUEUE=analytics-service.core-events
RABBITMQ_CORE_EVENTS_BINDINGS=rbac.#
RABBITMQ_CORE_EVENTS_DLX=core.events.dlx
RABBITMQ_CORE_EVENTS_DLQ=analytics-service.core-events.dlq

# In the video slice, point this at play/mock-core instead of a real
# core-service.
CORE_SERVICE_BASE_URL=http://localhost:4200
CORE_INTERNAL_API_KEY=dev-internal-key

RBAC_CACHE_TTL_SEC=300
EVENT_IDS_TTL_DAYS=7

CORS_ORIGINS=http://localhost:3000
