{
  "info": {
    "name": "QuickBite Analytics Service",
    "description": "Read-only analytics endpoints under /api/v1/analytics. All routes require a valid access token (JWT, HS256) and the analytics:read permission. Date-range endpoints accept ISO-8601 'from'/'to' query params.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "quickbite-analytics-service"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "restaurantId", "value": "1" },
    { "key": "branchId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "from", "value": "2026-01-01" },
    { "key": "to", "value": "2026-01-31" }
  ],
  "item": [
    {
      "name": "Restaurants",
      "item": [
        {
          "name": "Get restaurant days",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/restaurants/{{restaurantId}}/days?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "restaurants", "{{restaurantId}}", "days"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        },
        {
          "name": "Get restaurant failure rate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/restaurants/{{restaurantId}}/failure-rate?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "restaurants", "{{restaurantId}}", "failure-rate"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        },
        {
          "name": "Get restaurant delivery average",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/restaurants/{{restaurantId}}/delivery-avg?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "restaurants", "{{restaurantId}}", "delivery-avg"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        },
        {
          "name": "Get active restaurants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/restaurants/active?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "restaurants", "active"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Branches",
      "item": [
        {
          "name": "Get branch days",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/branches/{{branchId}}/days?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "branches", "{{branchId}}", "days"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        },
        {
          "name": "Get branch failure rate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/branches/{{branchId}}/failure-rate?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "branches", "{{branchId}}", "failure-rate"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get product days",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/products/{{productId}}/days?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "products", "{{productId}}", "days"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Platform",
      "item": [
        {
          "name": "Get platform days",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/platform/days?from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "platform", "days"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        }
      ]
    }
  ]
}
